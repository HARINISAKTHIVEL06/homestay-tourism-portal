# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas Cloud Cluster or Local)
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/homestay_portal?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/homestay_portal

# JWT Security Credentials
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here
JWT_EXPIRE=1d
JWT_REFRESH_EXPIRE=7d

# Email Service (Nodemailer / Ethereal / SendGrid)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email
EMAIL_PASS=your_password
EMAIL_FROM=noreply@tourism.gov.in

